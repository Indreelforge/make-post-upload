# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Make API token with the sdk-apps:read and sdk-apps:write scopes (Profile → API → Add token).
MAKE_API_KEY=
# The zone your Make organization lives in, as a bare hostname: eu1.make.com, eu2.make.com, us1.make.com, us2.make.com …
MAKE_ZONE=
# Optional: only used when the app is created (default "global" from app.json).
# MAKE_APP_AUDIENCE=
