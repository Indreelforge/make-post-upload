{
	"baseUrl": "https://api.post-upload.com",
	"headers": {
		"Authorization": "Apikey {{connection.apiKey}}"
	},
	"response": {
		"error": {
			"502": {
				"message": "[502] {{if(body.success = false, body.message, 'Post-Upload is temporarily unavailable (bad gateway). Try again in a few minutes.')}}"
			},
			"503": {
				"message": "[503] Post-Upload is temporarily unavailable (service unavailable). Try again in a few minutes."
			},
			"504": {
				"message": "[504] Post-Upload is temporarily unavailable (gateway timeout). Try again in a few minutes."
			},
			"message": "[{{statusCode}}] {{ifempty(body.error, body.message)}}{{if(body.error_code, ' (' + body.error_code + ')', '')}}"
		}
	},
	"log": {
		"sanitize": [
			"request.headers.authorization"
		]
	}
}
