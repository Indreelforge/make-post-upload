[
	{
		"name": "profile",
		"type": "select",
		"label": "Profile",
		"options": "rpc://getProfiles",
		"required": true,
		"help": "The profile whose posting queue to use."
	},
	{
		"name": "timezone",
		"type": "text",
		"label": "Time zone",
		"required": true,
		"help": "IANA time zone of the slot times, for example `Asia/Kolkata`."
	},
	{
		"name": "slots",
		"type": "array",
		"label": "Slot times",
		"required": true,
		"spec": {
			"type": "text",
			"label": "Slot time",
			"validate": {
				"pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
			}
		},
		"validate": {
			"minItems": 1,
			"maxItems": 24
		},
		"help": "Times of day in 24-hour `HH:MM` format, up to 24."
	},
	{
		"name": "days_of_week",
		"type": "select",
		"label": "Posting days",
		"multiple": true,
		"required": true,
		"options": [
			{
				"label": "Sunday",
				"value": 0
			},
			{
				"label": "Monday",
				"value": 1
			},
			{
				"label": "Tuesday",
				"value": 2
			},
			{
				"label": "Wednesday",
				"value": 3
			},
			{
				"label": "Thursday",
				"value": 4
			},
			{
				"label": "Friday",
				"value": 5
			},
			{
				"label": "Saturday",
				"value": 6
			}
		]
	},
	{
		"name": "max_posts_per_slot",
		"type": "uinteger",
		"label": "Maximum posts per slot",
		"default": 1,
		"validate": {
			"min": 1,
			"max": 10
		}
	}
]
