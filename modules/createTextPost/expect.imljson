[
	{
		"name": "profile",
		"type": "select",
		"label": "Profile",
		"options": "rpc://getProfiles",
		"required": true,
		"help": "The Post-Upload profile. Its social accounts are connected in the [Post-Upload dashboard](https://post-upload.com/dashboard/users)."
	},
	{
		"name": "platforms",
		"type": "select",
		"label": "Platforms",
		"multiple": true,
		"required": true,
		"options": [
			{
				"label": "Bluesky",
				"value": "bluesky"
			},
			{
				"label": "Dev.to",
				"value": "devto"
			},
			{
				"label": "Discord",
				"value": "discord"
			},
			{
				"label": "Facebook",
				"value": "facebook"
			},
			{
				"label": "Google Business Profile",
				"value": "google_business"
			},
			{
				"label": "Hashnode",
				"value": "hashnode"
			},
			{
				"label": "Lemmy",
				"value": "lemmy"
			},
			{
				"label": "LinkedIn",
				"value": "linkedin"
			},
			{
				"label": "Listmonk",
				"value": "listmonk"
			},
			{
				"label": "Mastodon",
				"value": "mastodon"
			},
			{
				"label": "Nostr",
				"value": "nostr"
			},
			{
				"label": "Reddit",
				"value": "reddit"
			},
			{
				"label": "Slack",
				"value": "slack"
			},
			{
				"label": "Telegram",
				"value": "telegram"
			},
			{
				"label": "Threads",
				"value": "threads"
			},
			{
				"label": "Whop",
				"value": "whop"
			},
			{
				"label": "WordPress",
				"value": "wordpress"
			},
			{
				"label": "X (formerly Twitter)",
				"value": "x"
			}
		],
		"help": "Networks to publish the text post to. Each must be connected to the profile."
	},
	{
		"name": "title",
		"type": "text",
		"label": "Title or caption",
		"multiline": true,
		"required": true,
		"help": "The post text. It is the video title on YouTube, the article title on Dev.to and Hashnode, the post title on Lemmy, the email subject on Listmonk, and the caption everywhere else."
	},
	{
		"name": "description",
		"type": "text",
		"label": "Description",
		"multiline": true,
		"help": "Optional longer text: the YouTube description, the Markdown body on Dev.to, Hashnode, Lemmy, Whop forums and Listmonk, and added below the title on the other networks."
	},
	{
		"name": "schedule",
		"type": "date",
		"label": "Schedule at",
		"help": "Publish later at this date and time. Leave empty to publish now."
	},
	{
		"name": "timezone",
		"type": "text",
		"label": "Time zone",
		"help": "IANA time zone saved with the post, for example `America/New_York`. Make sends the date with its UTC offset, so the time zone does not move the publish time."
	},
	{
		"name": "add_to_queue",
		"type": "boolean",
		"label": "Add to queue",
		"help": "Post at the profile's next free queue slot instead of now."
	},
	{
		"name": "first_comment",
		"type": "text",
		"label": "First comment",
		"help": "Posted as the first comment right after publishing (Instagram, Facebook, X, LinkedIn, Threads, YouTube, Bluesky, Reddit)."
	},
	{
		"name": "reference",
		"type": "text",
		"label": "Your reference",
		"help": "Your own unique ID for this post, sent as `request_id`. The Get an upload status module accepts it later."
	},
	{
		"name": "facebook_page_id",
		"type": "select",
		"label": "Facebook page",
		"options": "rpc://getFacebookPages",
		"advanced": true,
		"help": "The Facebook page to post to. Default: the page chosen when Facebook was connected."
	},
	{
		"name": "target_linkedin_page_id",
		"type": "select",
		"label": "LinkedIn page",
		"options": "rpc://getLinkedinPages",
		"advanced": true,
		"help": "Post as this LinkedIn company page instead of the personal profile."
	},
	{
		"name": "gbp_location_id",
		"type": "select",
		"label": "Google Business location",
		"options": "rpc://getGoogleBusinessLocations",
		"advanced": true,
		"help": "The Google Business Profile location to post to. Default: the first location."
	},
	{
		"name": "reddit_subreddit",
		"type": "text",
		"label": "Subreddit",
		"advanced": true,
		"help": "Required when posting to Reddit. The subreddit name without r/, for example `test`."
	},
	{
		"name": "devto_tags",
		"type": "text",
		"label": "Dev.to tags",
		"advanced": true,
		"help": "Up to 4 comma-separated tags for the Dev.to article, for example `javascript, webdev`."
	},
	{
		"name": "lemmy_url",
		"type": "url",
		"label": "Lemmy link",
		"advanced": true,
		"help": "An `https://` link. On a text post it makes a Lemmy link post; on a photo post it is added to the end of the body."
	},
	{
		"name": "listmonk_draft",
		"type": "boolean",
		"label": "Listmonk draft",
		"advanced": true,
		"help": "Create the Listmonk campaign as a draft instead of emailing every subscriber on the connected lists right away."
	},
	{
		"name": "platform_options",
		"type": "array",
		"label": "Other platform options",
		"advanced": true,
		"spec": [
			{
				"name": "key",
				"type": "text",
				"label": "Option",
				"required": true
			},
			{
				"name": "value",
				"type": "text",
				"label": "Value"
			}
		],
		"help": "Other platform-specific API fields sent as-is, for example `youtube_tags`, `pinterest_link` or `reddit_flair_id`. See the [platform guides](https://docs.post-upload.com/platform-guides/tiktok)."
	}
]
